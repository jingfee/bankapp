# Every variable the deployment uses. Placeholders only: never commit real values.

# --- Read by the app today ---

# Port the app listens on inside the container.
PORT=3000

# Directory with the built frontend. Set by the image; only override for custom builds.
STATIC_DIR=/app/public

# --- For upcoming features (not read yet) ---

# Enable Banking application id, from the Enable Banking control panel.
ENABLE_BANKING_APPLICATION_ID=replace-me

# Path of the Enable Banking private key inside the container (the compose file mounts it here).
ENABLE_BANKING_PRIVATE_KEY_PATH=/run/secrets/enablebanking.pem

# Directory for the database and backups (the compose file mounts a volume here).
DATA_DIR=/data
