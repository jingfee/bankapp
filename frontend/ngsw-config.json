{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "navigationUrls": ["/**", "!/**/*.*", "!/**/*__*", "!/**/*__*/**", "!/api/**"],
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/icons/*",
          "/*.css",
          "/*.js",
          "/media/*.woff2"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "opened",
      "urls": [
        "/api/overview/**",
        "/api/transactions",
        "/api/transactions?**",
        "/api/transactions/**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "timeout": "5s",
        "maxSize": 500,
        "maxAge": "30d"
      }
    },
    {
      "name": "pages",
      "urls": [
        "/api/accounts",
        "/api/banks",
        "/api/categories",
        "/api/household-ratio",
        "/api/subcategory-shares",
        "/api/manual-savings-accounts",
        "/api/mortgage",
        "/api/mortgage/**",
        "/api/overview",
        "/api/overview?**",
        "/api/savings",
        "/api/settlement"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "timeout": "5s",
        "maxSize": 200,
        "maxAge": "30d"
      }
    }
  ]
}
