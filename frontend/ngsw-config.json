{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "navigationUrls": ["/**", "!/**/*.*", "!/**/*__*", "!/**/*__*/**", "!/api/**"],
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/icons/*",
          "/*.css",
          "/*.js"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "overview",
      "urls": ["/api/accounts"],
      "cacheConfig": {
        "strategy": "freshness",
        "timeout": "5s",
        "maxSize": 1,
        "maxAge": "30d"
      }
    },
    {
      "name": "transactions",
      "urls": ["/api/transactions", "/api/transactions?*"],
      "cacheConfig": {
        "strategy": "freshness",
        "timeout": "5s",
        "maxSize": 200,
        "maxAge": "30d"
      }
    }
  ]
}
