# Local development configuration. Copy to backend/.env (git-ignored) and fill in.
# Relative paths are resolved from backend/. Variables set in the shell take precedence.

# Enable Banking application id, from the Enable Banking control panel.
ENABLE_BANKING_APPLICATION_ID=replace-me

# Path of the Enable Banking private key (PEM). Keep it outside the repository.
ENABLE_BANKING_PRIVATE_KEY_PATH=/home/you/secrets/enablebanking.pem

# Must also be registered as a redirect URL in the Enable Banking application.
REDIRECT_URL=https://localhost:4200/api/connections/callback

# Directory for the local database (data/ is git-ignored).
DATA_DIR=./data

TIMEZONE=Europe/Stockholm

# Optional. The owner's personnummer (12 digits), passed to banks that take it when connecting.
# PERSONNUMMER=
